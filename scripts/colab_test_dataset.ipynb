# RSHaze+ Dataset Colab 测试脚本 (Stage 5B-1)

```python
# @title 设置环境
import sys
from pathlib import Path

# 设置路径
project_root = Path('/content/CrossModal-Defog-OVOD')
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

# 检查数据集
data_dir = Path('/content/datasets/RSHaze+')
if not data_dir.exists():
    print(f"[ERROR] 数据集目录不存在：{data_dir}")
    print("请先下载 RSHaze+ 数据集")
else:
    print(f"[OK] 数据集目录存在：{data_dir}")

# @title 1. 测试 Dataset
from src.data import HazeDensityDataset

print("\n" + "="*60)
print("测试 1: Dataset 加载")
print("="*60)

# 训练集
train_ds = HazeDensityDataset(
    root='/content/datasets/RSHaze+',
    split='train',
    image_size=256,
)
print(f"Train: {len(train_ds)} samples")

# 验证集
val_ds = HazeDensityDataset(
    root='/content/datasets/RSHaze+',
    split='val',
    image_size=256,
    split_file='/content/experiments/haze_density/rshazeplus_split.json',
)
print(f"Val: {len(val_ds)} samples")

# 测试集
test_ds = HazeDensityDataset(
    root='/content/datasets/RSHaze+',
    split='test',
    image_size=256,
)
print(f"Test: {len(test_ds)} samples")

# 统计
stats = train_ds.get_stats()
print(f"\nSubset distribution:")
for subset, count in stats['current_subset_counts'].items():
    print(f"  {subset}: {count}")

# @title 2. 测试 Sample
print("\n" + "="*60)
print("测试 2: Sample 格式")
print("="*60)

sample = train_ds[0]
print(f"Keys: {list(sample.keys())}")
print(f"Image shape: {sample['image'].shape}")
print(f"Image dtype: {sample['image'].dtype}")
print(f"Image range: [{sample['image'].min():.4f}, {sample['image'].max():.4f}]")
print(f"Subset: {sample['subset']}")
print(f"ID: {sample['id']}")

# @title 3. 测试 Batch
print("\n" + "="*60)
print("测试 3: Batch 格式")
print("="*60)

from torch.utils.data import DataLoader

train_loader = DataLoader(
    train_ds,
    batch_size=4,
    shuffle=True,
    num_workers=2,
    pin_memory=True,
)

batch = next(iter(train_loader))
print(f"Batch image shape: {batch['image'].shape}")
print(f"Expected: [4, 3, 256, 256]")
print(f"Subsets: {batch['subset']}")

# @title 4. 测试 DataLoader Builder
print("\n" + "="*60)
print("测试 4: DataLoader Builder")
print("="*60)

from src.data import build_rshazeplus_dataloader

train_loader = build_rshazeplus_dataloader(
    root='/content/datasets/RSHaze+',
    split='train',
    image_size=256,
    batch_size=4,
    num_workers=2,
)

val_loader = build_rshazeplus_dataloader(
    root='/content/datasets/RSHaze+',
    split='val',
    image_size=256,
    batch_size=4,
    num_workers=2,
    split_file='/content/experiments/haze_density/rshazeplus_split.json',
)

test_loader = build_rshazeplus_dataloader(
    root='/content/datasets/RSHaze+',
    split='test',
    image_size=256,
    batch_size=4,
    num_workers=2,
)

print(f"Train batches: {len(train_loader)}")
print(f"Val batches: {len(val_loader)}")
print(f"Test batches: {len(test_loader)}")

# @title 5. 测试 512 模式
print("\n" + "="*60)
print("测试 5: 512 模式")
print("="*60)

test_ds_512 = HazeDensityDataset(
    root='/content/datasets/RSHaze+',
    split='test',
    image_size=512,
)

sample_512 = test_ds_512[0]
print(f"Image shape: {sample_512['image'].shape}")
print(f"Expected: [3, 512, 512]")

# @title 6. 测试 return_clean
print("\n" + "="*60)
print("测试 6: return_clean")
print("="*60)

train_ds_clean = HazeDensityDataset(
    root='/content/datasets/RSHaze+',
    split='train',
    image_size=256,
    return_clean=True,
)

sample_clean = train_ds_clean[0]
print(f"Keys: {list(sample_clean.keys())}")
